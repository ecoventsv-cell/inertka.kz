---
import '../styles/global.css';
import { site, waLink } from '../data/site';

interface Props {
  title: string;
  description: string;
  schema?: object[];
}
const { title, description, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();

const org = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#org`,
  name: site.name,
  url: site.url,
  telephone: site.phone.replace(/\s/g, ''),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ул. Бейбитшилик, 18/1, БЦ «Сервер», офис 14',
    addressLocality: 'Астана',
    addressCountry: 'KZ',
  },
  areaServed: { '@type': 'City', name: 'Астана' },
  priceRange: '₸₸',
  image: `${site.url}/img/dostavka-samosval.webp`,
};
const allSchema = [org, ...schema];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="theme-color" content="#44403c" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;700&family=Unbounded:wght@600;700&display=swap" />
  {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <header class="top">
    <div class="wrap">
      <a class="logo" href="/"><i></i><span>Инерт<em>ка</em></span></a>
      <nav class="nav">
        <a href="/dresva/">Дресва</a>
        <a href="/shheben/">Щебень</a>
        <a href="/beton/">Бетон</a>
        <a href="/dostavka/">Доставка и оплата</a>
        <a href="/blog/">Статьи</a>
        <a href="/kontakty/">Контакты</a>
      </nav>
      <a class="top-phone" href={site.phoneHref}>{site.phone}</a>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <div class="wrap cols">
      <div>
        <b>Инертка — инертные материалы и бетон в Астане</b><br />
        Дресва, щебень 20-40, 5-20, 0-50, бетон.<br />
        Цены с НДС, оплата перечислением, сертификаты.
      </div>
      <div>
        <b>Каталог</b><br />
        <a href="/dresva/">Дресва</a><br />
        <a href="/shheben/">Щебень</a><br />
        <a href="/shheben/20-40/">Щебень 20-40</a><br />
        <a href="/shheben/5-20/">Щебень 5-20</a><br />
        <a href="/shheben/0-50/">Щебень 0-50</a><br />
        <a href="/shheben/optom/">Щебень оптом</a><br />
        <a href="/beton/">Бетон</a><br />
        <a href="/beton/m300/">Бетон М300</a><br />
        <a href="/beton/peskobeton/">Пескобетон</a>
      </div>
      <div>
        <b>Контакты</b><br />
        <a href={site.phoneHref}>{site.phone}</a> — {site.manager}<br />
        <a href={waLink()} rel="nofollow">Написать в WhatsApp</a><br />
        {site.address}
      </div>
    </div>
  </footer>

  <a class="wa-float" href={waLink()} aria-label="Написать в WhatsApp" rel="nofollow" target="_blank">
    <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 7L3 29l6.4-2c2 1.1 4.3 1.7 6.6 1.7 7.2 0 13-5.7 13-12.8S23.2 3 16 3zm0 23.4c-2.1 0-4.1-.6-5.9-1.7l-.4-.3-3.8 1.2 1.2-3.7-.3-.4c-1.2-1.8-1.9-3.9-1.9-6 0-5.9 4.9-10.7 11-10.7s11 4.8 11 10.7-4.9 10.9-10.9 10.9zm6-8c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1c-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2s0-.5.1-.6l.5-.6c.2-.2.2-.4.3-.6.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.1 1.1-1.1 2.7 1.2 3.2 1.3 3.4c.2.2 2.3 3.5 5.6 4.9.8.3 1.4.5 1.9.7.8.2 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z"/></svg>
  </a>
</body>
</html>
