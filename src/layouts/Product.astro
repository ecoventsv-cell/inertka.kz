---
import Base from './Base.astro';
import Calc from '../components/Calc.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { getCollection } from 'astro:content';
import { site, waLink, fmt, terms, type Product } from '../data/site';
import { faqSchema, productSchema, crumbsSchema } from '../data/schema';

interface Props {
  product: Product;
  title: string;
  description: string;
  lead: string;
  faq: { q: string; a: string }[];
  crumbs: { name: string; path: string }[];
}
const { product: p, title, description, lead, faq, crumbs } = Astro.props;
const posts = (await getCollection('blog')).filter(
  (x) => x.data.product === p.key || (p.key.startsWith('shheben') && x.data.product === 'shheben')
);
const schema = [productSchema(p, description), faqSchema(faq), crumbsSchema(crumbs)];
const waText = `Здравствуйте! Нужна ${p.name.toLowerCase()}, объём: … т, адрес: …`;
---
<Base title={title} description={description} schema={schema}>
  <section class="hero">
    <div class="wrap">
      <nav class="crumbs" style="color:#d6d3d1">
        {crumbs.slice(0, -1).map((c) => <><a href={c.path} style="color:#d6d3d1">{c.name}</a> › </>)}
      </nav>
      <h1>{p.h1}</h1>
      <p style="font-size:1.6rem;font-weight:800;color:#fdba74;margin:.2em 0">{fmt(p.price!)} ₸ за тонну с НДС</p>
      <p>{lead}</p>
      <div class="btns">
        <a class="btn btn-wa" href={waLink(waText)} rel="nofollow" target="_blank">Заказать в WhatsApp</a>
        <a class="btn btn-call" href={site.phoneHref}>{site.phone}</a>
      </div>
    </div>
  </section>
  <div class="wrap">
    <ul class="terms" style="margin-top:24px">{terms.map((t) => <li>{t}</li>)}</ul>
    <div class="prose">
      <Calc selected={p.key} />
      <slot />
      <Cta wa={waText} />
      <Faq items={faq} />
      {posts.length > 0 && (
        <>
          <h2>Статьи по теме</h2>
          <ul>{posts.map((x) => <li><a href={`/blog/${x.id}/`}>{x.data.h1}</a></li>)}</ul>
        </>
      )}
    </div>
  </div>
</Base>
