---
import Base from '../../layouts/Base.astro';
import BetonCalc from '../../components/BetonCalc.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import Trust from '../../components/Trust.astro';
import { peskobeton, beton, betonDelivery, site, waLink, fmt } from '../../data/site';
import { faqSchema, crumbsSchema } from '../../data/schema';

const faq = [
  { q: 'Сколько стоит пескобетон в Астане?', a: `От ${fmt(peskobeton[0].price)} ₸ за м³ (М100) до ${fmt(peskobeton.at(-1)!.price)} ₸ (М300), с НДС. Доставка миксером — 40 000 ₸ за рейс до 8 м³ или 5 000 ₸ за м³ от 8 м³.` },
  { q: 'Чем пескобетон отличается от бетона?', a: 'В нём нет щебня — только песок, цемент и вода. Он для стяжек, тонких слоёв и подливок. Для фундаментов берут обычный бетон.' },
  { q: 'Какую марку пескобетона брать для стяжки?', a: 'Для стяжки пола в доме — М150–М200. Для гаража и полов под нагрузку — М250–М300.' },
  { q: 'Можно ли залить пескобетоном фундамент?', a: 'Не рекомендуем: без щебня усадка больше, выше риск трещин. Для фундамента нужен бетон М250–М300.' },
  { q: 'Сколько стоит пескобетон на стяжку 100 м²?', a: 'Стяжка 5 см — около 5,3 м³ с запасом. Пескобетон М200: 5,3 × 30 500 ≈ 161 650 ₸, плюс доставка 40 000 ₸ за рейс. Итого около 201 650 ₸ с НДС.' },
  { q: 'Можно ли подать пескобетон на второй этаж?', a: 'Да, через бетононасос. Обсудите это с менеджером при заказе: нужно согласовать время и место установки насоса.' },
  { q: 'Когда можно класть плитку на стяжку?', a: 'Обычно через 2–3 недели при нормальной температуре. Ламинат и паркет — после полного высыхания, через 4 недели и больше.' },
];
const crumbs = [{ name: 'Главная', path: '/' }, { name: 'Бетон', path: '/beton/' }, { name: 'Пескобетон', path: '/beton/peskobeton/' }];
const product = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Пескобетон товарный',
  description: 'Пескобетон М100–М300 с доставкой миксером по Астане. Цены за м³ с НДС.',
  image: `${site.url}/img/peskobeton.webp`,
  brand: { '@type': 'Brand', name: site.name },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'KZT',
    lowPrice: peskobeton[0].price,
    highPrice: peskobeton.at(-1)!.price,
    offerCount: peskobeton.length,
    availability: 'https://schema.org/InStock',
  },
};
const waText = 'Здравствуйте! Нужен пескобетон, марка: …, объём: … м³, адрес и дата: …';
const m200 = peskobeton.find((x) => x.mark === 'М200')!;
---
<Base
  title={`Пескобетон в Астане — от ${fmt(peskobeton[0].price)} ₸/м³ с НДС, доставка | Инертка`}
  description={`Товарный пескобетон М100–М300 в Астане: от ${fmt(peskobeton[0].price)} ₸ за м³ с НДС. Для стяжек, полов, подливок. Доставка миксером по городу, оплата перечислением.`}
  schema={[product, faqSchema(faq), crumbsSchema(crumbs)]}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <nav class="crumbs"><a href="/">Главная</a> › <a href="/beton/">Бетон</a> › </nav>
        <h1>Пескобетон в Астане с доставкой миксером</h1>
        <p class="hero-price">от {fmt(peskobeton[0].price)} ₸ <small>за м³ с НДС</small></p>
        <p>Товарный пескобетон М100–М300 для стяжек, полов, подливок и тонких конструкций. Привозим миксером по всей Астане.</p>
        <div class="btns">
          <a class="btn btn-wa" href={waLink(waText)} rel="nofollow" target="_blank">Заказать в WhatsApp</a>
          <a class="btn btn-call" href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>
      <div class="hero-photo wide">
        <img src="/img/peskobeton.webp" width="560" height="369" alt="Пескобетон при выгрузке" fetchpriority="high" />
        <div class="badge"><b>М100–М300</b>для стяжек и полов</div>
      </div>
    </div>
  </section>
  <div class="wrap">
    <Trust />
    <div class="prose">
      <h2>Цены на пескобетон</h2>
      <table class="price-table">
        <thead><tr><th>Марка</th><th>Класс</th><th>Цена за м³ с НДС</th></tr></thead>
        <tbody>{peskobeton.map((x) => <tr><td>{x.mark}</td><td>{x.cls}</td><td class="p">{fmt(x.price)} ₸</td></tr>)}</tbody>
      </table>
      <p>Доставка по Астане: до 8 м³ — {fmt(betonDelivery.tripUpTo8)} ₸ за рейс, от 8 м³ — {fmt(betonDelivery.perM3From8)} ₸ за м³. Цены с НДС.</p>
      <BetonCalc type="p" />

      <h2>Что такое пескобетон</h2>
      <p>
        Это бетон без щебня: цемент, песок и вода. Смесь мелкая и однородная, поэтому ровно ложится тонким слоем,
        затекает в узкие места и даёт гладкую поверхность. Привозим его готовым, миксером, как обычный бетон.
      </p>

      <h2>Где применяют</h2>
      <ul>
        <li><b>Стяжка пола</b> по плитам перекрытия и по грунту, толщиной 3–8 см.</li>
        <li><b>Полы</b> в гаражах, складах, подсобных помещениях.</li>
        <li><b>Подливка</b> под оборудование, заполнение пустот и щелей.</li>
        <li><b>Тонкие конструкции</b>: подоконные плиты, перемычки малой толщины.</li>
        <li><b>Выравнивание</b> оснований перед укладкой покрытий.</li>
      </ul>

      <h2>Какую марку выбрать</h2>
      <table>
        <thead><tr><th>Задача</th><th>Марка</th></tr></thead>
        <tbody>
          <tr><td>Подготовка, выравнивание</td><td>М100–М150</td></tr>
          <tr><td>Стяжка пола в жилом доме</td><td>М150–М200</td></tr>
          <tr><td>Пол в гараже, мастерской</td><td>М250</td></tr>
          <tr><td>Полы под нагрузку, склад</td><td>М300</td></tr>
        </tbody>
      </table>

      <h2>Пример расчёта: стяжка в доме</h2>
      <p>Площадь 120 м², стяжка 5 см.<br>
        Объём: 120 × 0,05 = 6 м³, с запасом — 6,3 м³.<br>
        Пескобетон М200: 6,3 × {fmt(m200.price)} = {fmt(Math.round(6.3 * m200.price))} ₸. Доставка — один рейс, {fmt(betonDelivery.tripUpTo8)} ₸.<br>
        <b>Итого {fmt(Math.round(6.3 * m200.price) + betonDelivery.tripUpTo8)} ₸ с НДС.</b></p>

      <h2>Сколько пескобетона нужно на стяжку</h2>
      <table>
        <thead><tr><th>Площадь</th><th>Стяжка 4 см</th><th>Стяжка 5 см</th><th>Стяжка 7 см</th></tr></thead>
        <tbody>
          {[50, 80, 120, 200, 500].map((a) => (
            <tr><td>{a} м²</td><td>{(a * 0.04).toFixed(1).replace('.', ',')} м³</td><td>{(a * 0.05).toFixed(1).replace('.', ',')} м³</td><td>{(a * 0.07).toFixed(1).replace('.', ',')} м³</td></tr>
          ))}
        </tbody>
      </table>
      <p>Добавьте 3–5% запаса на неровности основания. Если пол сильно гуляет по уровню, замерьте самую низкую и самую высокую точку и считайте по средней толщине.</p>

      <h2>Как делают стяжку из товарного пескобетона</h2>
      <ol>
        <li><b>Подготовить основание.</b> Убрать мусор и пыль, плиты перекрытия загрунтовать, по грунту — уплотнённая подсыпка и плёнка.</li>
        <li><b>Демпферная лента</b> по периметру стен — чтобы стяжка не треснула от расширения.</li>
        <li><b>Маяки</b> по уровню через 1–1,5 м.</li>
        <li><b>Армирование</b> — сетка или фибра, особенно для стяжки толще 5 см и по грунту.</li>
        <li><b>Подача.</b> Из миксера — по лотку или насосом, если этаж выше первого.</li>
        <li><b>Разравнивание</b> правилом по маякам, без доливания воды.</li>
        <li><b>Уход:</b> первые 7 дней укрывать плёнкой и увлажнять, сквозняков не допускать.</li>
      </ol>
      <p>Ходить по стяжке можно через 2–3 дня, укладывать плитку — через 2–3 недели, ламинат и паркет — когда стяжка полностью высохнет, обычно через 4 недели и больше.</p>

      <h2>Товарный пескобетон или сухая смесь в мешках</h2>
      <p>
        На маленький ремонт берут сухую смесь в мешках: насыпал, добавил воды, перемешал. Но уже на 3–4 кубах
        это неудобно. Один куб стяжки — это около 50 мешков по 40 кг, которые надо поднять, распечатать и
        перемешать по одному. Готовый пескобетон из миксера даёт одинаковую смесь по всей площади, и стяжку
        большой комнаты или целого этажа можно залить за один день без швов.
      </p>
      <table>
        <thead><tr><th></th><th>Товарный пескобетон</th><th>Сухая смесь в мешках</th></tr></thead>
        <tbody>
          <tr><td>Объём</td><td>от 1 м³ и больше</td><td>удобно до 1 м³</td></tr>
          <tr><td>Однородность</td><td>одинаковая смесь</td><td>зависит от замеса</td></tr>
          <tr><td>Скорость</td><td>этаж за день</td><td>комната за день</td></tr>
          <tr><td>Работа</td><td>только разровнять</td><td>поднять, замешать, разровнять</td></tr>
        </tbody>
      </table>

      <h2>Типичные ошибки</h2>
      <ul>
        <li><b>Стяжка без демпферной ленты</b> — трещины вдоль стен.</li>
        <li><b>Слишком тонко</b> — меньше 3 см пескобетон по плитам перекрытия ломается.</li>
        <li><b>Слишком быстро сушат</b> обогревателями — поверхность трескается и пылит.</li>
        <li><b>Пескобетон в фундамент</b> — без щебня усадка больше, для фундамента нужен <a href="/beton/m300/">бетон М300</a>.</li>
      </ul>

      <h2>Пескобетон или бетон с щебнем</h2>
      <p>
        Толстое и нагруженное — <a href="/beton/">бетон</a>: фундаменты, стены, площадки толще 10 см.
        Тонкое и ровное — пескобетон. Цены близкие: бетон М200 — {fmt(beton[2].price)} ₸, пескобетон М200 — {fmt(m200.price)} ₸.
        Подробное сравнение — в статье <a href="/blog/peskobeton-ili-beton/">пескобетон или бетон</a>.
      </p>

      <Cta wa={waText} />
      <Faq items={faq} />
    </div>
  </div>
</Base>
