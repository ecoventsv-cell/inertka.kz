---
import Base from '../../layouts/Base.astro';
import BetonCalc from '../../components/BetonCalc.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import Trust from '../../components/Trust.astro';
import { markPages, type MarkPage } from '../../data/marks';
import { beton, betonDelivery, sulfatePlus, site, waLink, fmt } from '../../data/site';
import { faqSchema, crumbsSchema } from '../../data/schema';

export function getStaticPaths() {
  return markPages.map((m) => ({ params: { mark: m.slug }, props: { m } }));
}
const { m } = Astro.props as { m: MarkPage };
const row = beton.find((x) => x.mark === m.mark)!;
const nb = m.neighbors.map((n) => beton.find((x) => x.mark === n)!);
const crumbs = [
  { name: 'Главная', path: '/' },
  { name: 'Бетон', path: '/beton/' },
  { name: m.mark, path: `/beton/${m.slug}/` },
];
const title = `Бетон ${m.mark} в Астане — ${fmt(row.price)} ₸/м³ с НДС, доставка | Инертка`;
const description = `Бетон ${m.mark} (${row.cls}) в Астане: ${fmt(row.price)} ₸ за м³ с НДС. Доставка миксером по городу. Для ${m.use}. Оплата перечислением.`;
const waText = `Здравствуйте! Нужен бетон ${m.mark}, объём: … м³, адрес и дата: …`;
const product = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `Бетон ${m.mark} (${row.cls})`,
  description,
  image: `${site.url}/img/beton.webp`,
  brand: { '@type': 'Brand', name: site.name },
  offers: {
    '@type': 'Offer',
    price: row.price,
    priceCurrency: 'KZT',
    availability: 'https://schema.org/InStock',
    url: `${site.url}/beton/${m.slug}/`,
    seller: { '@id': `${site.url}/#org` },
  },
};
const others = markPages.filter((x) => x.slug !== m.slug);
// Ориентировочный состав на 1 м³ (цемент М400) и типовые показатели — для справки, точное по проекту.
const comp: Record<string, { c: number; sand: string; stone: string; w: number; f: string; wt: string }> = {
  'М100': { c: 200, sand: '0,55', stone: '1,25', w: 180, f: 'F50', wt: 'W2' },
  'М150': { c: 240, sand: '0,52', stone: '1,22', w: 180, f: 'F50–F75', wt: 'W2' },
  'М200': { c: 280, sand: '0,50', stone: '1,20', w: 185, f: 'F100', wt: 'W4' },
  'М250': { c: 310, sand: '0,48', stone: '1,18', w: 185, f: 'F100–F150', wt: 'W4–W6' },
  'М300': { c: 350, sand: '0,45', stone: '1,15', w: 190, f: 'F150–F200', wt: 'W6–W8' },
  'М350': { c: 390, sand: '0,43', stone: '1,10', w: 195, f: 'F200', wt: 'W8' },
  'М400': { c: 430, sand: '0,40', stone: '1,08', w: 195, f: 'F200–F300', wt: 'W8–W10' },
  'М450': { c: 470, sand: '0,38', stone: '1,05', w: 195, f: 'F300', wt: 'W10–W12' },
};
const k = comp[m.mark];
const vols = [3, 5, 8, 10, 15, 20, 30, 50];
const dlv = (v: number) => (v < 8 ? betonDelivery.tripUpTo8 : v * betonDelivery.perM3From8);
---
<Base title={title} description={description} schema={[product, faqSchema(m.faq), crumbsSchema(crumbs)]}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <nav class="crumbs"><a href="/">Главная</a> › <a href="/beton/">Бетон</a> › </nav>
        <h1>Бетон {m.mark} в Астане с доставкой</h1>
        <p class="hero-price">{fmt(row.price)} ₸ <small>за м³ с НДС · класс {row.cls}</small></p>
        <p>{m.lead}</p>
        <div class="btns">
          <a class="btn btn-wa" href={waLink(waText)} rel="nofollow" target="_blank">Заказать в WhatsApp</a>
          <a class="btn btn-call" href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>
      <div class="hero-photo">
        <img src="/img/beton.webp" width="516" height="560" alt={`Бетон ${m.mark}`} fetchpriority="high" />
        <div class="badge"><b>{m.mark} · {row.cls}</b>доставка миксером по Астане</div>
      </div>
    </div>
  </section>
  <div class="wrap">
    <Trust />
    <div class="prose">
      <h2>Цена бетона {m.mark}</h2>
      <table class="price-table">
        <tbody>
          <tr><td>Бетон {m.mark} ({row.cls})</td><td class="p">{fmt(row.price)} ₸/м³</td></tr>
          <tr><td>Сульфатостойкий {m.mark}</td><td class="p">{fmt(row.price + sulfatePlus)} ₸/м³</td></tr>
          <tr><td>Доставка до 8 м³</td><td class="p">{fmt(betonDelivery.tripUpTo8)} ₸ за рейс</td></tr>
          <tr><td>Доставка от 8 м³</td><td class="p">{fmt(betonDelivery.perM3From8)} ₸/м³</td></tr>
        </tbody>
      </table>
      <p>Все цены с НДС. Оплата перечислением, документы на каждую поставку.</p>
      <BetonCalc mark={m.mark} />
      <Fragment set:html={m.body} />
      <h2>Сколько стоит бетон {m.mark} с доставкой</h2>
      <table>
        <thead><tr><th>Объём</th><th>Бетон</th><th>Доставка</th><th>Итого с НДС</th><th>За 1 м³</th></tr></thead>
        <tbody>
          {vols.map((v) => (
            <tr><td>{v} м³</td><td>{fmt(v * row.price)} ₸</td><td>{fmt(dlv(v))} ₸</td><td><b>{fmt(v * row.price + dlv(v))} ₸</b></td><td>{fmt(Math.round((v * row.price + dlv(v)) / v))} ₸</td></tr>
          ))}
        </tbody>
      </table>
      <p>Видно, что до 8 кубов доставка заметно поднимает цену куба. Если заливка небольшая, выгоднее объединить её с другой работой и заказать от 8 м³ за раз.</p>

      <h2>Состав и характеристики бетона {m.mark}</h2>
      <p>Ориентировочный состав на 1 м³ — для понимания, из чего складывается цена. Точную рецептуру подбирает лаборатория завода под цемент и заполнители.</p>
      <table>
        <tbody>
          <tr><td>Цемент М400</td><td>≈ {k.c} кг</td></tr>
          <tr><td>Песок</td><td>≈ {k.sand} м³</td></tr>
          <tr><td>Щебень</td><td>≈ {k.stone} т</td></tr>
          <tr><td>Вода</td><td>≈ {k.w} л</td></tr>
          <tr><td>Морозостойкость (обычно)</td><td>{k.f}</td></tr>
          <tr><td>Водонепроницаемость (обычно)</td><td>{k.wt}</td></tr>
        </tbody>
      </table>
      <p>
        Если в проекте указаны морозостойкость (F), водонепроницаемость (W) или подвижность (П) — передайте менеджеру всю строку
        обозначения, подберём смесь. Как читать эти буквы — в статье <a href="/blog/marka-i-klass-betona/">марка и класс бетона</a>.
      </p>

      <h2>Как принять бетон на объекте</h2>
      <ol>
        <li><b>Проверьте накладную:</b> марка, класс, объём и время замеса должны совпадать с заказом.</li>
        <li><b>Посмотрите на смесь</b> в лотке: однородная, без комков цемента и расслоения на воду и камень.</li>
        <li><b>Не разрешайте доливать воду</b> в миксер «чтобы легче шло» — каждый лишний литр снижает прочность.</li>
        <li><b>Укладывайте сразу:</b> обычная смесь должна быть уложена примерно за 1,5–2 часа после замеса.</li>
        <li><b>На ответственных объектах</b> отберите образцы-кубики для лаборатории.</li>
      </ol>

      <h2>Когда бетон {m.mark} наберёт прочность</h2>
      <table>
        <thead><tr><th>Срок при +20 °С</th><th>Прочность</th><th>Что можно делать</th></tr></thead>
        <tbody>
          <tr><td>1–3 суток</td><td>≈ 30%</td><td>ходить, снимать боковую опалубку</td></tr>
          <tr><td>7 суток</td><td>≈ 65–70%</td><td>начинать лёгкие работы сверху</td></tr>
          <tr><td>14 суток</td><td>≈ 80–90%</td><td>снимать опалубку перекрытий (по проекту)</td></tr>
          <tr><td>28 суток</td><td>100%</td><td>полная нагрузка</td></tr>
        </tbody>
      </table>
      <p>В холод сроки растягиваются: при +10 °С примерно вдвое, при +5 °С — втрое. Как ухаживать за бетоном в первые дни — в статье <a href="/blog/uhod-za-betonom/">уход за бетоном</a>.</p>
      <h2>Как заказать бетон {m.mark}</h2>
      <ol class="steps">
        <li><b>Заявка</b><span>Марка, объём, адрес и время заливки — в WhatsApp или по телефону. Если объём не посчитан, пришлите размеры.</span></li>
        <li><b>Счёт с НДС</b><span>Менеджер подтверждает цену, время и число миксеров, выставляет счёт.</span></li>
        <li><b>Заливка</b><span>Миксеры приходят к назначенному времени, с накладными на каждую машину.</span></li>
      </ol>
      <p>
        Если на объекте нужны ещё <a href="/shheben/20-40/">щебень</a> на подушку под фундамент или
        <a href="/dresva/">дресва</a> на обратную засыпку — их можно заказать у нас же. Один поставщик,
        один договор и один комплект документов для технадзора.
      </p>
      <h2>Соседние марки</h2>
      <table>
        <thead><tr><th>Марка</th><th>Класс</th><th>Цена за м³</th></tr></thead>
        <tbody>
          {nb.map((x) => {
            const page = markPages.find((p) => p.mark === x.mark);
            return <tr><td>{page ? <a href={`/beton/${page.slug}/`}>{x.mark}</a> : x.mark}</td><td>{x.cls}</td><td>{fmt(x.price)} ₸</td></tr>;
          })}
        </tbody>
      </table>
      <p>Все марки от М100 до М450 и пескобетон — на странице <a href="/beton/">бетон в Астане</a>.</p>
      <Cta wa={waText} />
      <Faq items={m.faq} />
      <h2>Другие марки</h2>
      <ul>{others.map((x) => <li><a href={`/beton/${x.slug}/`}>Бетон {x.mark}</a></li>)}<li><a href="/beton/peskobeton/">Пескобетон</a></li></ul>
    </div>
  </div>
</Base>
