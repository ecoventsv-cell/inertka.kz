---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import { faqSchema } from '../data/schema';

const faq = [
  { q: 'Сколько стоит доставка щебня и дресвы по Астане?', a: 'При заказе от 100 тонн доставка по Астане бесплатна — она уже в цене материала. До 100 тонн доставка платная, сумму называет менеджер под ваш адрес.' },
  { q: 'Как оплатить?', a: 'Перечислением на расчётный счёт по счёту с НДС.' },
  { q: 'Какие документы даёте?', a: 'Договор поставки, счёт, счёт-фактуру, накладные и сертификат на материал.' },
];
---
<Base
  title="Доставка и оплата щебня и дресвы по Астане | Инертка"
  description="От 100 тонн доставка дресвы и щебня по Астане включена в цену. Оплата перечислением, цены с НДС, сертификаты и закрывающие документы."
  schema={[faqSchema(faq)]}
>
  <div class="wrap prose">
    <nav class="crumbs"><a href="/">Главная</a> › Доставка и оплата</nav>
    <h1>Доставка и оплата</h1>
    <h2>Доставка</h2>
    <ul>
      <li><b>От 100 тонн</b> — доставка по всей Астане включена в цену материала.</li>
      <li><b>До 100 тонн</b> — доставка платная, сумму называет менеджер под ваш адрес и объём.</li>
      <li>Большие объёмы возим рейсами по согласованному графику.</li>
    </ul>
    <h2>Оплата</h2>
    <ul>
      <li>Цены за тонну, уже с НДС.</li>
      <li>Оплата перечислением на расчётный счёт.</li>
      <li>Договор поставки, счёт-фактура, накладные.</li>
    </ul>
    <h2>Документы на материал</h2>
    <p>На дресву и щебень есть сертификаты. Копию отправляем со счётом — для технадзора и исполнительной документации.</p>
    <h2>Скидки</h2>
    <p>Для больших объёмов скидка обсуждается индивидуально. Напишите объём и график поставки — менеджер предложит цену.</p>
    <Cta />
    <Faq items={faq} />
  </div>
</Base>
