---
import Base from '../../layouts/Base.astro';
import Calc from '../../components/Calc.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import ProductCard from '../../components/ProductCard.astro';
import Trust from '../../components/Trust.astro';
import { products, fmt, terms, waLink, site } from '../../data/site';
import { faqSchema, crumbsSchema } from '../../data/schema';
import { getCollection } from 'astro:content';

const items = products.filter((p) => p.key.startsWith('shheben'));
const faq = [
  { q: 'Сколько стоит щебень в Астане?', a: 'Щебень 20-40 — 7 500 ₸/т, щебень 5-20 — 7 500 ₸/т, щебень 0-50 — 7 000 ₸/т. Цены с НДС. От 100 тонн доставка по Астане включена.' },
  { q: 'Какой щебень нужен для фундамента?', a: 'Для бетона фундамента — 20-40. Для подушки под фундамент подойдёт и 20-40, и 0-50, если подушку хорошо уплотнят.' },
  { q: 'Какой щебень лучше для дороги или парковки?', a: 'Для основания — 0-50: он уплотняется плотнее и дешевле. Если нужен дренирующий слой, берут 20-40.' },
  { q: 'Есть доставка щебня по Астане?', a: 'Да. При заказе от 100 тонн доставка по всему городу включена в цену. До 100 тонн — платная, сумму называет менеджер.' },
];
const crumbs = [{ name: 'Главная', path: '/' }, { name: 'Щебень', path: '/shheben/' }];
const posts = (await getCollection('blog')).filter((x) => x.data.product.startsWith('shheben'));
---
<Base
  title="Купить щебень в Астане — цена от 7 000 ₸/т с НДС, доставка | Инертка"
  description="Купить щебень в Астане: 20-40 и 5-20 — 7 500 ₸/т, 0-50 — 7 000 ₸/т с НДС. От 100 т доставка по городу включена. Сертификаты, оплата перечислением."
  schema={[faqSchema(faq), crumbsSchema(crumbs)]}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <nav class="crumbs"><a href="/">Главная</a> › </nav>
        <h1>Щебень в Астане с доставкой</h1>
        <p class="hero-price">от 7 000 ₸ <small>за тонну с НДС</small></p>
        <p>Три ходовые фракции: 20-40 для фундаментов и дренажа, 5-20 для бетона тонких конструкций и дорожек, 0-50 для оснований дорог и площадок. От 100 тонн доставка по Астане включена.</p>
        <div class="btns">
          <a class="btn btn-wa" href={waLink('Здравствуйте! Нужен щебень, фракция: …, объём: … т, адрес: …')} rel="nofollow" target="_blank">Заказать в WhatsApp</a>
          <a class="btn btn-call" href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>
      <div class="hero-photo">
        <img src="/img/dostavka-samosval.webp" width="476" height="470" alt="Самосвал выгружает щебень" fetchpriority="high" />
        <div class="badge"><b>от 100 т</b>доставка по Астане бесплатно</div>
      </div>
    </div>
  </section>
  <div class="wrap">
    <Trust />
    <div class="grid">
      {items.map((p) => (
        <ProductCard href={`/${p.slug}/`} img={p.img} w={p.w} h={p.h} name={p.name} price={fmt(p.price!)} unit="за тонну" text={p.short} />
      ))}
    </div>
    <ul class="terms">{terms.map((t) => <li>{t}</li>)}</ul>
    <div class="prose">
      <Calc selected="shheben-20-40" />
      <p>Нужен большой объём или поставки по графику? Условия для оптовых покупателей — на странице <a href="/shheben/optom/">щебень оптом</a>.</p>
      <h2>Какую фракцию выбрать</h2>
      <table>
        <thead><tr><th>Задача</th><th>Фракция</th></tr></thead>
        <tbody>
          <tr><td>Бетон для фундамента, плит, монолита</td><td><a href="/shheben/20-40/">20-40</a></td></tr>
          <tr><td>Бетон для перекрытий, тонких стен, густой арматуры</td><td><a href="/shheben/5-20/">5-20</a></td></tr>
          <tr><td>Отмостка, дорожки, производство плитки и ЖБИ</td><td><a href="/shheben/5-20/">5-20</a></td></tr>
          <tr><td>Дренаж, отвод воды от фундамента</td><td><a href="/shheben/20-40/">20-40</a></td></tr>
          <tr><td>Подушка под фундамент</td><td>20-40 или 0-50</td></tr>
          <tr><td>Основание дороги, проезда</td><td><a href="/shheben/0-50/">0-50</a></td></tr>
          <tr><td>Парковка, промплощадка, склад</td><td><a href="/shheben/0-50/">0-50</a></td></tr>
          <tr><td>Обратная засыпка, подъём участка</td><td><a href="/dresva/">дресва</a> — дешевле</td></tr>
        </tbody>
      </table>
      <p>
        Простое правило: если щебень пойдёт в бетон или должен пропускать воду — нужен 20-40, где камни
        одного размера. Если нужен плотный слой под нагрузку — 0-50, где мелочь заполняет пустоты.
        Для засыпки, где важен объём, а не прочность, выгоднее <a href="/dresva/">дресва</a> за 6 000 ₸/т.
      </p>
      <h2>Почему цена за тонну, а не за куб</h2>
      <p>
        Тонну проверяют на весах, а куб в кузове — на глаз, и он зависит от того, как материал улёгся.
        Продажа по весу честнее для обеих сторон. Чтобы перевести: в кубе щебня 20-40 около 1,4 т,
        в кубе 5-20 — около 1,4 т, в кубе 0-50 — около 1,55 т.
      </p>
      <h2>Как посчитать щебень</h2>
      <p><b>На подушку или основание:</b> площадь × толщина × 1,25–1,3 (запас на уплотнение) × вес куба (1,4 т для 20-40 и 5-20, 1,55 т для 0-50).</p>
      <p><b>На бетон:</b> около 1,2 т щебня на каждый куб бетона.</p>
      <p>
        Пример: площадка 20 × 30 м под слой 20 см из щебня 0-50 — 600 × 0,2 × 1,25 × 1,55 ≈ 233 т,
        это 1 631 000 ₸ с НДС. Объём больше 100 тонн — доставка по Астане в цене.
      </p>
      <h2>Как проходит поставка</h2>
      <ol class="steps">
        <li><b>Заявка</b><span>Фракция, объём, адрес, дата — в WhatsApp или по телефону.</span></li>
        <li><b>Счёт</b><span>Цена с НДС, график машин, договор.</span></li>
        <li><b>Доставка</b><span>Самосвалы по графику, накладные и сертификат.</span></li>
      </ol>
      <p>Большой объём или поставки по графику — условия на странице <a href="/shheben/optom/">щебень оптом</a>.</p>
      <Cta />
      <Faq items={faq} />
      {posts.length > 0 && (
        <>
          <h2>Статьи о щебне</h2>
          <ul>{posts.map((x) => <li><a href={`/blog/${x.id}/`}>{x.data.h1}</a></li>)}</ul>
        </>
      )}
    </div>
  </div>
</Base>
