---
import Base from '../layouts/Base.astro';
import Calc from '../components/Calc.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import ProductCard from '../components/ProductCard.astro';
import Trust from '../components/Trust.astro';
import { products, fmt, terms, waLink, site, beton } from '../data/site';
import { faqSchema } from '../data/schema';

const faq = [
  { q: 'Какие цены на инертные материалы?', a: 'Дресва — 6 000 ₸/т, щебень 20-40 — 7 500 ₸/т, щебень 0-50 — 7 000 ₸/т. Все цены с НДС.' },
  { q: 'Сколько стоит бетон?', a: `От ${fmt(beton[0].price)} ₸/м³ (М100) до ${fmt(beton.at(-1)!.price)} ₸/м³ (М450) с НДС, доставка миксером по Астане.` },
  { q: 'Какой минимальный заказ?', a: 'Поставляем любой объём. От 100 тонн доставка по Астане включена в цену, до 100 тонн — доставка платная.' },
  { q: 'Работаете с юрлицами?', a: 'Да. Договор поставки, цены с НДС, оплата перечислением, полный пакет закрывающих документов и сертификаты на материал.' },
  { q: 'Есть скидки?', a: 'На большие объёмы скидка обсуждается индивидуально — напишите объём и график поставки.' },
  { q: 'Куда доставляете?', a: 'По всей Астане. От 100 тонн доставка входит в цену материала.' },
];
---
<Base
  title="Дресва, щебень и бетон в Астане с доставкой | Инертка"
  description="Дресва 6 000 ₸/т, щебень 20-40 — 7 500 ₸/т, 0-50 — 7 000 ₸/т, бетон от 29 500 ₸/м³. Цены с НДС, от 100 т доставка включена. Сертификаты, перечисление."
  schema={[faqSchema(faq)]}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Астана · цены с НДС · сертификаты</p>
        <h1>Дресва, щебень и бетон с доставкой на объект</h1>
        <p>Привозим инертные материалы и бетон по всей Астане. Работаем официально: договор, оплата перечислением, документы на каждую машину.</p>
        <ul class="chips">
          {products.map((p) => <li>{p.name} — <b>{fmt(p.price!)} ₸/т</b></li>)}
          <li>Бетон — <b>от {fmt(beton[0].price)} ₸/м³</b></li>
        </ul>
        <div class="btns">
          <a class="btn btn-wa" href={waLink()} rel="nofollow" target="_blank">Написать в WhatsApp</a>
          <a class="btn btn-call" href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>
      <div class="hero-photo">
        <img src="/img/dostavka-samosval.webp" width="476" height="470" alt="Самосвал выгружает щебень на объекте" fetchpriority="high" />
        <div class="badge"><b>от 100 т</b>доставка по Астане бесплатно</div>
      </div>
    </div>
  </section>
  <div class="wrap">
    <Trust />
    <h2>Материалы и цены</h2>
    <div class="grid">
      {products.map((p) => (
        <ProductCard href={`/${p.slug}/`} img={p.img} w={p.w} h={p.h} name={p.name} price={fmt(p.price!)} unit="за тонну" text={p.short} />
      ))}
      <ProductCard href="/beton/" img="/img/beton.webp" w={516} h={560} name="Бетон М100–М450" price={`от ${fmt(beton[0].price)}`} unit="за м³" text="Товарный бетон и пескобетон. Доставка миксером по Астане." more="Цены по маркам" />
    </div>
    <div class="prose">
      <Calc />
    </div>
    <h2>Что выбрать под задачу</h2>
    <div class="prose">
      <table>
        <thead><tr><th>Задача</th><th>Что заказать</th></tr></thead>
        <tbody>
          <tr><td>Засыпать котлован, пазухи, поднять участок</td><td><a href="/dresva/">Дресва</a> — самый выгодный вариант</td></tr>
          <tr><td>Щебень в бетон, дренаж, подушка под фундамент</td><td><a href="/shheben/20-40/">Щебень 20-40</a></td></tr>
          <tr><td>Основание дороги, парковки, площадки</td><td><a href="/shheben/0-50/">Щебень 0-50</a></td></tr>
          <tr><td>Готовый бетон на фундамент, стены, плиты</td><td><a href="/beton/">Бетон М250–М300</a></td></tr>
        </tbody>
      </table>
    </div>
    <h2>Как заказать</h2>
    <ol class="steps">
      <li><b>Напишите или позвоните</b><span>Материал, объём, адрес и дата. Посчитаем тонны и сумму бесплатно.</span></li>
      <li><b>Получите счёт с НДС</b><span>Менеджер подтвердит цену, сроки и график машин.</span></li>
      <li><b>Оплатите перечислением</b><span>Машины едут на объект. С ними — накладные и сертификат.</span></li>
    </ol>
    <h2>Условия на дресву и щебень</h2>
    <ul class="terms">{terms.map((t) => <li>{t}</li>)}</ul>
    <div class="prose">
      <Cta />
      <Faq items={faq} />
    </div>
  </div>
</Base>
