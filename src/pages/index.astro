---
import Base from '../layouts/Base.astro';
import Calc from '../components/Calc.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { products, fmt, terms, waLink, site, beton } from '../data/site';
import { faqSchema } from '../data/schema';

const faq = [
  { q: 'Какие цены на инертные материалы?', a: 'Дресва — 6 000 ₸/т, щебень 20-40 — 7 500 ₸/т, щебень 0-50 — 7 000 ₸/т. Все цены с НДС.' },
  { q: 'Сколько стоит бетон?', a: `От ${fmt(beton[0].price)} ₸/м³ (М100) до ${fmt(beton.at(-1)!.price)} ₸/м³ (М450) с НДС, доставка миксером по Астане.` },
  { q: 'Какой минимальный заказ?', a: 'Поставляем любой объём. От 100 тонн доставка по Астане включена в цену, до 100 тонн — доставка платная.' },
  { q: 'Работаете с юрлицами?', a: 'Да. Договор поставки, цены с НДС, оплата перечислением, полный пакет закрывающих документов и сертификаты на материал.' },
  { q: 'Есть скидки?', a: 'На большие объёмы скидка обсуждается индивидуально — напишите объём и график поставки.' },
  { q: 'Куда доставляете?', a: 'По всей Астане. От 100 тонн доставка входит в цену материала.' },
];
---
<Base
  title="Дресва, щебень и бетон в Астане с доставкой | Инертка"
  description="Дресва 6 000 ₸/т, щебень 20-40 — 7 500 ₸/т, 0-50 — 7 000 ₸/т, бетон от 29 500 ₸/м³. Цены с НДС, от 100 т доставка включена. Сертификаты, перечисление."
  schema={[faqSchema(faq)]}
>
  <section class="hero">
    <div class="wrap">
      <h1>Дресва, щебень и бетон в Астане с доставкой</h1>
      <p>Цены с НДС. На дресву и щебень от 100 тонн доставка по всей Астане включена. Бетон — с доставкой миксером. Официальная поставка, оплата перечислением.</p>
      <div class="btns">
        <a class="btn btn-wa" href={waLink()} rel="nofollow" target="_blank">Написать в WhatsApp</a>
        <a class="btn btn-call" href={site.phoneHref}>{site.phone}</a>
      </div>
    </div>
  </section>
  <div class="wrap">
    <h2>Материалы и цены</h2>
    <div class="grid">
      {products.map((p) => (
        <div class="card">
          <h3><a href={`/${p.slug}/`}>{p.name}</a></h3>
          <div class="price">{fmt(p.price!)} ₸ <small>за тонну с НДС</small></div>
          <p>{p.short}</p>
          <a class="more" href={`/${p.slug}/`}>Подробнее →</a>
        </div>
      ))}
      <div class="card">
        <h3><a href="/beton/">Бетон</a></h3>
        <div class="price">от {fmt(beton[0].price)} ₸ <small>за м³ с НДС</small></div>
        <p>М100–М450 и пескобетон. Доставка миксером по Астане.</p>
        <a class="more" href="/beton/">Цены по маркам →</a>
      </div>
    </div>
    <h2>Условия на дресву и щебень</h2>
    <ul class="terms">{terms.map((t) => <li>{t}</li>)}</ul>
    <div class="prose">
      <Calc />
      <h2>Что выбрать под задачу</h2>
      <ul>
        <li><b>Засыпать котлован, пазухи, поднять участок</b> — <a href="/dresva/">дресва</a>, самый выгодный вариант.</li>
        <li><b>Щебень в бетон, дренаж, подушка</b> — <a href="/shheben/20-40/">щебень 20-40</a>.</li>
        <li><b>Готовый бетон на фундамент</b> — <a href="/beton/">бетон М250–М300</a> с доставкой миксером.</li>
        <li><b>Основание дороги, парковки, площадки</b> — <a href="/shheben/0-50/">щебень 0-50</a>.</li>
      </ul>
      <h2>Как заказать</h2>
      <ol>
        <li>Напишите в WhatsApp или позвоните: материал, объём, адрес.</li>
        <li>Менеджер подтвердит сумму и сроки и выставит счёт с НДС.</li>
        <li>Оплата перечислением — и машины едут на объект.</li>
      </ol>
      <Cta />
      <Faq items={faq} />
    </div>
  </div>
</Base>
