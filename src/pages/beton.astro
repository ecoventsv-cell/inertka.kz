---
import Base from '../layouts/Base.astro';
import BetonCalc from '../components/BetonCalc.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { getCollection } from 'astro:content';
import { beton, peskobeton, sulfatePlus, betonDelivery, site, waLink, fmt } from '../data/site';
import { faqSchema, crumbsSchema } from '../data/schema';
import { markPages } from '../data/marks';
const markLink = (m: string) => markPages.find((x) => x.mark === m);

const faq = [
  { q: 'Сколько стоит куб бетона в Астане?', a: `От ${fmt(beton[0].price)} ₸ за м³ (М100) до ${fmt(beton.at(-1)!.price)} ₸ (М450). Ходовой М300 — ${fmt(beton[4].price)} ₸/м³. Цены с НДС.` },
  { q: 'Сколько стоит доставка бетона миксером?', a: `До 8 м³ — ${fmt(betonDelivery.tripUpTo8)} ₸ за рейс. От 8 м³ — ${fmt(betonDelivery.perM3From8)} ₸ за каждый куб. По Астане, с НДС.` },
  { q: 'Какой бетон нужен для фундамента частного дома?', a: 'Обычно М250–М300 (В20–В22,5). Точную марку указывает проект.' },
  { q: 'Что такое сульфатостойкий бетон?', a: `Бетон на сульфатостойком цементе — для фундаментов в агрессивных, засолённых грунтах. Стоит на ${sulfatePlus} ₸/м³ дороже обычного.` },
  { q: 'Чем пескобетон отличается от бетона?', a: 'В пескобетоне нет щебня — только песок и цемент. Он нужен для стяжек, тонких конструкций, подливок. Для фундаментов берут обычный бетон с щебнем.' },
  { q: 'Работаете с НДС и по перечислению?', a: 'Да. Цены с НДС, оплата перечислением, документы на каждую поставку.' },
];
const crumbs = [{ name: 'Главная', path: '/' }, { name: 'Бетон', path: '/beton/' }];
const offers = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Товарный бетон в Астане',
  description: 'Бетон М100–М450 и пескобетон с доставкой миксером по Астане. Цены за м³ с НДС.',
  image: `${site.url}/img/beton.webp`,
  brand: { '@type': 'Brand', name: site.name },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'KZT',
    lowPrice: Math.min(...peskobeton.map((x) => x.price)),
    highPrice: Math.max(...beton.map((x) => x.price)),
    offerCount: beton.length + peskobeton.length,
    availability: 'https://schema.org/InStock',
  },
};
const posts = (await getCollection('blog')).filter((x) => x.data.product === 'beton');
const waText = 'Здравствуйте! Нужен бетон, марка: …, объём: … м³, адрес: …';
---
<Base
  title="Купить бетон в Астане — цена за куб от 29 500 ₸, доставка | Инертка"
  description="Товарный бетон М100–М450 и пескобетон в Астане: цена за куб с НДС. М200 — 31 500 ₸/м³, М300 — 34 000 ₸/м³ с НДС. Доставка миксером по городу. Оплата перечислением."
  schema={[offers, faqSchema(faq), crumbsSchema(crumbs)]}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <nav class="crumbs"><a href="/">Главная</a> › </nav>
        <h1>Товарный бетон в Астане с доставкой миксером</h1>
        <p class="hero-price">от {fmt(beton[0].price)} ₸ <small>за м³ с НДС</small></p>
        <p>Товарный бетон от М100 до М450 и пескобетон. Привозим миксером на объект по всей Астане. Оплата перечислением.</p>
        <div class="btns">
          <a class="btn btn-wa" href={waLink(waText)} rel="nofollow" target="_blank">Заказать в WhatsApp</a>
          <a class="btn btn-call" href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>
      <div class="hero-photo">
        <img src="/img/beton.webp" width="516" height="560" alt="Свежий товарный бетон" fetchpriority="high" />
        <div class="badge"><b>М100–М450</b>и пескобетон</div>
      </div>
    </div>
  </section>
  <div class="wrap prose">
    <h2>Цены на бетон</h2>
    <table class="price-table">
      <thead><tr><th>Марка</th><th>Класс</th><th>Цена за м³ с НДС</th></tr></thead>
      <tbody>{beton.map((x) => <tr><td>{markLink(x.mark) ? <a href={`/beton/${markLink(x.mark)!.slug}/`}>{x.mark}</a> : x.mark}</td><td>{x.cls}</td><td class="p">{fmt(x.price)} ₸</td></tr>)}</tbody>
    </table>
    <p>Сульфатостойкий бетон — плюс {sulfatePlus} ₸ к цене за куб.</p>

    <h2>Цены на пескобетон</h2>
    <p>Подробнее о марках и применении — на странице <a href="/beton/peskobeton/">пескобетон в Астане</a>.</p>
    <figure class="figure"><img src="/img/peskobeton.webp" width="560" height="369" alt="Пескобетон при выгрузке" loading="lazy" /></figure>
    <table class="price-table">
      <thead><tr><th>Марка</th><th>Класс</th><th>Цена за м³ с НДС</th></tr></thead>
      <tbody>{peskobeton.map((x) => <tr><td>{x.mark}</td><td>{x.cls}</td><td class="p">{fmt(x.price)} ₸</td></tr>)}</tbody>
    </table>

    <h2>Доставка бетона по Астане</h2>
    <table class="price-table">
      <tbody>
        <tr><td>от 1 до 8 м³</td><td class="p">{fmt(betonDelivery.tripUpTo8)} ₸ за рейс</td></tr>
        <tr><td>от 8 м³</td><td class="p">{fmt(betonDelivery.perM3From8)} ₸ за м³</td></tr>
      </tbody>
    </table>
    <p>Цены доставки с НДС. Чем больше объём, тем дешевле доставка в пересчёте на куб: при 3 м³ это больше 13 000 ₸ за куб, а от 8 м³ — 5 000 ₸.</p>

    <BetonCalc />

    <h2>Какую марку выбрать</h2>
    <table>
      <thead><tr><th>Задача</th><th>Марка</th></tr></thead>
      <tbody>
        <tr><td>Подбетонка под фундамент, подготовка</td><td>М100–М150</td></tr>
        <tr><td>Отмостка, дорожки, стяжка пола</td><td>М150–М200</td></tr>
        <tr><td>Фундамент частного дома, гаража, забора</td><td>М250–М300</td></tr>
        <tr><td>Монолитные стены, перекрытия, колонны</td><td>М300–М350</td></tr>
        <tr><td>Многоэтажный монолит, площадки под тяжёлую технику</td><td>М350–М400</td></tr>
        <tr><td>Гидротехника, мосты, особые нагрузки</td><td>М400–М450</td></tr>
      </tbody>
    </table>
    <p>
      Марку всегда указывает проект. Если проекта нет — для фундамента частного дома в Астане
      почти всегда берут М250 или М300. Переплачивать за М400 смысла нет, а М200 для фундамента
      маловато: зимой грунты здесь промерзают глубоко и давят на бетон с боков.
    </p>

    <h2>Марка и класс: что это</h2>
    <p>
      Марка (М200, М300) и класс (В15, В22,5) — два обозначения прочности. Марка — старая система,
      класс — современная, по нему считают проектировщики. Цифра марки — примерная прочность на сжатие
      в кг/см²: М300 выдерживает около 300 кг на каждый квадратный сантиметр. В таблице выше указаны оба
      обозначения — сверьте с проектом любое из них.
    </p>

    <h2>Сколько бетона заказать</h2>
    <p>Объём = длина × ширина × высота в метрах. Добавьте 3–5% запаса: часть остаётся в лотке и насосе, часть уходит на неровности опалубки.</p>
    <p><b>Пример.</b> Ленточный фундамент: периметр 44 м плюс внутренняя стена 10 м, ширина 0,4 м, высота 1,5 м.
      54 × 0,4 × 1,5 = 32,4 м³, с запасом — 34 м³. Бетон М300: 34 × {fmt(beton[4].price)} = {fmt(34 * beton[4].price)} ₸.
      Доставка: 34 × {fmt(betonDelivery.perM3From8)} = {fmt(34 * betonDelivery.perM3From8)} ₸.
      Итого <b>{fmt(34 * (beton[4].price + betonDelivery.perM3From8))} ₸ с НДС</b>.</p>

    <h2>Как проходит заказ</h2>
    <ol>
      <li>Пишете в WhatsApp: марка, объём, адрес, дата и время заливки.</li>
      <li>Менеджер подтверждает сумму и выставляет счёт с НДС.</li>
      <li>Оплата перечислением.</li>
      <li>Миксеры приезжают к назначенному времени. Большой объём — несколькими машинами по графику, чтобы заливка шла без перерывов.</li>
      <li>Вместе с бетоном — накладные и документы на смесь.</li>
    </ol>

    <h2>Что подготовить к приезду миксера</h2>
    <ul>
      <li><b>Подъезд.</b> Миксер — тяжёлая машина, ему нужна твёрдая дорога до места выгрузки. Если подъезда нет, нужен бетононасос или длинный лоток.</li>
      <li><b>Опалубку и арматуру</b> — проверить заранее, бетон ждать не будет.</li>
      <li><b>Людей и вибратор.</b> Бетон надо сразу распределить и провибрировать.</li>
      <li><b>Погоду.</b> Ниже +5 °С нужны противоморозные добавки и прогрев — обсудите с менеджером при заказе.</li>
    </ul>

    <p>
      Для подготовки под бетон и обратной засыпки фундамента у нас есть <a href="/shheben/20-40/">щебень 20-40</a>
      и <a href="/dresva/">дресва</a> — можно заказать всё вместе.
    </p>

    <Cta wa={waText} />
    <Faq items={faq} />
    {posts.length > 0 && (
      <>
        <h2>Статьи о бетоне</h2>
        <ul>{posts.map((x) => <li><a href={`/blog/${x.id}/`}>{x.data.h1}</a></li>)}</ul>
      </>
    )}
  </div>
</Base>
